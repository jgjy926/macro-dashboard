# Copy to .env (git-ignored) and fill in only what you actually want.
#
# THE ENGINE NEEDS NONE OF THESE. FRED, ALFRED and BLS all serve the data it
# uses without a key, which is what keeps the running cost at $0/month with no
# signup. Everything below is a strictly optional upgrade, and the engine never
# warns about their absence.

# ── Optional API keys ───────────────────────────────────────────────────────

# FRED_API_KEY — free from https://fredaccount.stlouisfed.org/apikeys
# Buys SPEED, not data. ALFRED's JSON API returns every vintage of a series in
# one call; keylessly it is one HTTP request per vintage. The resulting numbers
# are identical either way.
FRED_API_KEY=

# BEA_API_KEY — free UserID from https://apps.bea.gov/API/signup/
# Unused by default. Every BEA series the spec asks for (GDP, real GDP, personal
# income, PCE, savings, corporate profits) is mirrored on FRED under an id the
# engine already fetches keylessly, so adding BEA buys sub-component detail at
# the cost of the engine's no-signup property.
BEA_API_KEY=

# BLS_API_KEY — free from https://data.bls.gov/registrationEngine/
# Raises the BLS daily cap from 25 requests to 500. BLS is only a cross-check on
# FRED's CPI/employment mirrors, so exhausting the free cap costs a QA signal and
# nothing on the forecast path.
BLS_API_KEY=

# ── Paths ───────────────────────────────────────────────────────────────────

# MACRO_DB — where the SQLite database lives (default: ./macro_engine.db)
MACRO_DB=

# MACRO_DASHBOARD_DIR — the static dashboard repo the JSON feed is written into.
# Defaults to the sibling "Personal Dynamic Dashboard" directory.
MACRO_DASHBOARD_DIR=

# ── Tuning ──────────────────────────────────────────────────────────────────

# MACRO_HISTORY_START   earliest observation kept          (default 1970-01-01)
# MACRO_BACKTEST_START  earliest backtest as-of date        (default 1985-01-01)
# MACRO_ALFRED_DELAY    seconds between ALFRED requests     (default 0.35)
#   Self-throttling. ALFRED publishes no rate limit for the keyless endpoint, but
#   a vintage backfill issues thousands of calls; lowering this risks being cut
#   off mid-backfill, and FRED will start timing out other requests too.
# MACRO_HTTP_TIMEOUT    seconds per request                 (default 60)
# MACRO_HTTP_RETRIES    attempts before giving up           (default 3)
MACRO_HISTORY_START=
MACRO_BACKTEST_START=
MACRO_ALFRED_DELAY=
MACRO_HTTP_TIMEOUT=
MACRO_HTTP_RETRIES=
